{
  "kit": "1.0",
  "specifications": {
    "STXT-SPEC": "1.0",
    "STXT-TREE-SPEC": "1.0"
  },
  "categories": {
    "tree": "Parse `input` and emit its canonical tree (STXT-TREE-SPEC); it must equal `expected`, compared as a JSON value, never as text.",
    "parse-error": "Parsing `input` must fail; the first error reported must carry `error.code` and `error.line` (1-based)."
  },
  "cases": [
    {
      "id": "tree/blank-line",
      "category": "tree",
      "spec": "STXT-SPEC §10.3; STXT-TREE-SPEC §5",
      "description": "A blank line of a block is \"\" however it is written, and a block whose only line is blank is [\"\"], not [].",
      "input": "tree/blank-line.stxt",
      "expected": "tree/blank-line.json"
    },
    {
      "id": "tree/block-indent",
      "category": "tree",
      "spec": "STXT-SPEC §10.2",
      "description": "Indentation beyond the level of the block is literal content and is kept.",
      "input": "tree/block-indent.stxt",
      "expected": "tree/block-indent.json"
    },
    {
      "id": "tree/block-literal",
      "category": "tree",
      "spec": "STXT-SPEC §6.1",
      "description": "Inside a block, ':', '>>' and '#' are literal text.",
      "input": "tree/block-literal.stxt",
      "expected": "tree/block-literal.json"
    },
    {
      "id": "tree/block-root",
      "category": "tree",
      "spec": "STXT-SPEC §6, §8.5",
      "description": "A block node can be a root node.",
      "input": "tree/block-root.stxt",
      "expected": "tree/block-root.json"
    },
    {
      "id": "tree/bom-crlf",
      "category": "tree",
      "spec": "STXT-SPEC §3",
      "description": "A BOM and CRLF line endings are accepted; the BOM and every trailing CR are discarded.",
      "input": "tree/bom-crlf.stxt",
      "expected": "tree/bom-crlf.json"
    },
    {
      "id": "tree/comment-closes-block",
      "category": "tree",
      "spec": "STXT-SPEC §6.1, §9.1",
      "description": "A comment at the level of the block node (or shallower) closes the block.",
      "input": "tree/comment-closes-block.stxt",
      "expected": "tree/comment-closes-block.json"
    },
    {
      "id": "tree/comment-indent",
      "category": "tree",
      "spec": "STXT-SPEC §9, §11",
      "description": "A comment is validated like a node but never moves the hierarchy.",
      "input": "tree/comment-indent.stxt",
      "expected": "tree/comment-indent.json"
    },
    {
      "id": "tree/empty",
      "category": "tree",
      "spec": "STXT-TREE-SPEC §3",
      "description": "A document without nodes has an empty tree.",
      "input": "tree/empty.stxt",
      "expected": "tree/empty.json"
    },
    {
      "id": "tree/marks",
      "category": "tree",
      "spec": "STXT-SPEC §4.2",
      "description": "Combining marks (Mn, Mc) are name characters.",
      "input": "tree/marks.stxt",
      "expected": "tree/marks.json"
    },
    {
      "id": "tree/name-spacing",
      "category": "tree",
      "spec": "STXT-SPEC §4.1, §4.3",
      "description": "The logical name is trimmed and its inner whitespace runs compacted; the canonical name compacts every run of separators into one '-'.",
      "input": "tree/name-spacing.stxt",
      "expected": "tree/name-spacing.json"
    },
    {
      "id": "tree/names",
      "category": "tree",
      "spec": "STXT-SPEC §4.1, §4.3",
      "description": "Canonical names keep accents and are case-insensitive: 'Caña' and 'Cana' are different, 'Straße' and 'STRASSE' too (lower-casing, not case folding).",
      "input": "tree/names.stxt",
      "expected": "tree/names.json"
    },
    {
      "id": "tree/namespace-override",
      "category": "tree",
      "spec": "STXT-SPEC §7.2",
      "description": "A child may redeclare the namespace; its descendants inherit the new one and later siblings keep the old one.",
      "input": "tree/namespace-override.stxt",
      "expected": "tree/namespace-override.json"
    },
    {
      "id": "tree/nbsp",
      "category": "tree",
      "spec": "STXT-SPEC §4, §10",
      "description": "Blanks are only U+0020 and U+0009: a no-break space is content, neither trimmed nor making a line empty.",
      "input": "tree/nbsp.stxt",
      "expected": "tree/nbsp.json"
    },
    {
      "id": "tree/nfc",
      "category": "tree",
      "spec": "STXT-SPEC §4.1, §4.3",
